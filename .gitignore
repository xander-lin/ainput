# Build output
/build/
/builddir/
/build-*/
/compile_commands.json
/pkg/
/src/
/out/
/log.txt
*.pkg.tar.*

# Release artifacts produced by tools/make-release.sh; published on GitHub
# Releases, never committed (a binary in git history is forever).
/dist/

# Rust build artefacts (the meson build puts these in the build tree, but a
# bare `cargo build` uses these)
/rust/target/
Cargo.lock.bak

# Python environments and caches
.venv/
__pycache__/
*.pyc

# Editor / IDE state
.idea/
.vscode/
*.swp
*~

# Local tool state
.cortexkit/
