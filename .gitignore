# Build output (repo root only — a bare "src/" would also hide the
# tracked ASR_provider/src and adapter/src directories)
/build/
/builddir/
/compile_commands.json
/pkg/
/src/
/out/
/log.txt
*.pkg.tar.*

# Python environments and caches
.venv/
__pycache__/
*.pyc

# Runtime configuration: only config/*.example is tracked
config/*.json

# Editor / IDE state
.idea/
.vscode/
*.swp
*~

# Local tool state
.cortexkit/
