{
    // Active ASR backend: "qwen" | "doubao" | "zipformer" | "fire_red" | "mock".
    // Ctrl+CapsLock switching rewrites this line, so it always shows the
    // provider the next login will start with.
    "provider": "qwen",

    // Hotkey / UI behaviour.
    "ui": {
        "activation_msec": 300,        // how long CapsLock must be held
        "notification_timeout": 2000,  // switch notification duration (ms)
        "debounce_count": 2            // key-release debounce samples
    },

    // Capture pipeline. The code default is denoise off (leave the key out);
    // the value below is an example. crest_threshold=0 disables level gating.
    "audio": {
        "denoise": "speexdsp",         // "speexdsp" | "deepfilter" | "none"
        "lufs_target": -16.0,          // loudness target for gain normalization
        "speex_level": -15,            // speexdsp suppression level (dB)
        "crest_threshold": 2.4         // crest-based speech gate; 0 disables
    }
}
